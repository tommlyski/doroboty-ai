{
  "name": "doroboty-ai-case",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3001 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3001 --strictPort",
    "start": "npm run preview",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run design-system:check && npm run lint && npm run typecheck && npm test && npm run verify:packet && npm run build && npm run test:e2e",
    "package:participant": "node scripts/package-participant.mjs",
    "verify:packet": "node scripts/verify-participant.mjs",
    "design-system:check": "node docs/design-system/verify-kit.mjs && npm --prefix docs/design-system/agent-kit run check",
    "design-system:dev": "npm --prefix docs/design-system/agent-kit run dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@posthog/react": "^1.11.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "posthog-js": "^1.448.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^7.9.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "type": "module"
}
